# Copy to site/worker/.env (git-ignored) and fill in. `node site/deploy.mjs <domain> --secrets site/worker/.env`
# stores these as Worker secrets; later deploys keep them, so the file is only needed when a value changes.

# The One Connect app (One dashboard → the app's page). Its ask: Gmail, Custom, the four actions in gmail.mjs.
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_CONNECT_KEY=
ONE_PERMISSION_SET=

# Claude API key for the playground's runs. Give its workspace a monthly spend limit in the Claude Console.
ANTHROPIC_API_KEY=

# 32+ random characters; seals the session cookie and approval tokens. Changing it signs every visitor out.
SESSION_SECRET=
